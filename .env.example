# Database
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# dsn=postgresql://user:password@host:5432/database?sslmode=require

# Protect /api/admin/* and legacy attendance admin endpoints.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Protect /api/jobs/run. On Vercel, configure this as CRON_SECRET so Vercel
# Cron sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET=replace-with-a-second-long-random-secret

# Savara Mail. Every send logs in first, gets a token, then calls /send.
SAVARA_MAIL_BASE_URL=https://mail.savaralabs.com
SAVARA_MAIL_EMAIL=club@example.org
SAVARA_MAIL_PASSWORD=replace-with-savara-mail-password
# Backward-compatible names are also accepted:
# MAIL_USER_NAME=club@example.org
# MAIL_PASSWORD=replace-with-savara-mail-password

# Club operations
HOME_CLUB_NAMES=Rotary Club of Nakawa
ADMIN_NOTIFICATION_EMAILS=admin1@example.org,admin2@example.org
MAIL_JOB_INTERVAL_SECONDS=60

# Confirmation email content
EVENT_TIME=4:00 PM
EVENT_DETAILS_URL=https://your-attendance-site.example.org/
CLUB_CONTACT_PHONE=+256700000000
